{
    "name": "jobs-ie-scraper",
    "version": "0.1.0",
    "description": "Apify actor that scrapes structured job listings from jobs.ie (The Stepstone Group).",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:dev": "tsx src/main.ts",
        "start:prod": "node dist/main.js",
        "build": "tsc",
        "lint": "eslint src",
        "test": "node --import tsx --test src/*.test.ts"
    },
    "dependencies": {
        "apify": "^3.2.6",
        "crawlee": "^3.11.5"
    },
    "devDependencies": {
        "@apify/tsconfig": "^0.1.0",
        "@types/node": "^20.14.0",
        "tsx": "^4.16.0",
        "typescript": "^5.5.0"
    }
}
